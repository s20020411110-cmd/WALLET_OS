# Server-only Supabase project credentials; never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Twelve Data key is server-only. Keep the provider gate false until rights are verified.
TWELVE_DATA_API_KEY=
TWELVE_DATA_USAGE_APPROVED=false

# Set TWELVE_DATA_USAGE_APPROVED=true only after Twelve Data confirms:
# - this account can stream XAU/USD over WebSocket;
# - the intended commercial / third-party display use is licensed;
# - regional precious-metal data approval is granted where required;
# - any redistribution agreement required for the WALLET OS audience is signed.

MARKET_STALE_AFTER_MS=60000
MARKET_FALLBACK_INTERVAL_MS=30000
MARKET_SNAPSHOT_INTERVAL_MS=120000
MARKET_WORKER_HEALTH_HOST=127.0.0.1
MARKET_WORKER_HEALTH_PORT=8787
